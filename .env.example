# ==============================================================================
# Enterprise Infrastructure Monitoring & Incident Management Platform - Environment Config
# ==============================================================================

# Database Settings (PostgreSQL)
POSTGRES_DB=monitoring_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend API Settings
BACKEND_PORT=8090
SECRET_KEY=generate_a_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Prometheus & Alertmanager Integration
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093

# Notification Settings (Optional / Configurable)
# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@monitoring.local
SMTP_TO_EMAIL=noc-team@monitoring.local
